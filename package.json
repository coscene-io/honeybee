{
  "name": "honeybee",
  "version": "0.2.1-rc1",
  "license": "MPL-2.0 AND Proprietary",
  "private": true,
  "productName": "coStudio",
  "description": "coScene's robot visualization platform",
  "productDescription": "coScene Studio",
  "packageManager": "yarn@4.18.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/coscene-io/honeybee.git"
  },
  "author": {
    "name": "coScene Technologies",
    "email": "hi@coscene.io"
  },
  "homepage": "https://www.coscene.cn/",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "clean": "tsc --build --clean $(git ls-files 'packages/**/tsconfig.json') && rimraf --glob .webpack \"*/.webpack\" dist",
    "build:packages": "tsc --build --verbose $(git ls-files 'packages/**/tsconfig.json')",
    "typecheck:ci": "tsc --noEmit -p tsconfig.ci-typecheck.json",
    "typecheck:tooling:ts6": "tsc6 --noEmit -p tsconfig.json && tsc6 --noEmit -p packages/eslint-plugin/tsconfig.json && tsc6 --noEmit -p packages/studio-desktop/tsconfig.ts6-compat.json && tsc6 --noEmit -p packages/ws-protocol/tsconfig.json",
    "typecheck:eslint-plugin": "tsc --noEmit -p packages/eslint-plugin/tsconfig.json",
    "typecheck:message-path": "tsc --noEmit -p packages/message-path/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "web:build:dev": "rspack build --mode development --config web/rspack.config.ts",
    "web:build:prod": "rspack build --mode production --config web/rspack.config.ts",
    "web:serve": "rspack serve --env RSPACK_SERVE=true --mode development --config web/rspack.config.ts",
    "desktop:build:dev": "rspack build --mode development --config desktop/rspack.config.ts",
    "desktop:build:prod": "rspack build --mode production --config desktop/rspack.config.ts",
    "desktop:serve": "rspack serve --env RSPACK_SERVE=true --mode development --config desktop/rspack.config.ts",
    "desktop:start": "yarn workspace desktop electron .webpack",
    "benchmark:serve": "rspack serve --env RSPACK_SERVE=true --mode development --config benchmark/rspack.config.ts",
    "benchmark:build:prod": "rspack --mode production --config benchmark/rspack.config.ts",
    "license-check": "ts-node ci/license-check.ts",
    "lint": "oxlint --fix . && eslint --cache --cache-strategy content --cache-location .eslintcache --fix .",
    "lint:ci": "oxlint . && eslint --cache --cache-strategy content --cache-location .eslintcache . && prettier --check \"**/*.{cjs,js,jsx,mjs,ts,tsx}\"",
    "lint:unused-exports": "ts-node ./ci/lint-unused-exports.ts",
    "lint:dependencies": "knip --dependencies",
    "lint:inspect": "oxlint --print-config",
    "lint:inspect:eslint": "eslint --inspect-config",
    "test": "jest",
    "test:debug": "cross-env NODE_OPTIONS='--inspect-brk' jest",
    "test:watch": "jest --watch",
    "test:web-integration": "jest --forceExit --projects  web/integration-test",
    "test:web-integration:local": "BASE_URL=\"http://localhost:8080/\" jest --forceExit --projects  web/integration-test",
    "benchmark:remote-mp4": "jest --forceExit --projects web/integration-test --testPathPatterns=remoteMp4Benchmark.test.ts --runInBand",
    "package:win": "yarn package --win",
    "package:darwin": "yarn package --mac",
    "package:linux": "yarn package --linux",
    "package": "cross-env NODE_OPTIONS='-r ts-node/register' electron-builder build --config desktop/electronBuilderConfig.js --publish never",
    "package:e2e": "yarn && yarn clean && yarn desktop:build:prod && yarn package",
    "release:bump-nightly-version": "node -r ts-node/register ./ci/bump-nightly-version.ts",
    "version:all": "yarn workspaces foreach --all version",
    "typecheck:react19": "tsc --noEmit -p tsconfig.react19.json && tsc --noEmit -p tsconfig.react19-entrypoints.json"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "packages/@types/*",
      "web",
      "benchmark",
      "desktop"
    ]
  },
  "resolutions": {
    "@mui/material": "patch:@mui/material@npm:9.5.0#./patches/mui-material.patch",
    "@typescript/old": "npm:typescript@6.0.2",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "react-use": "patch:react-use@17.6.1#./patches/react-use.patch",
    "react-dnd": "patch:react-dnd@npm:16.0.1#./patches/react-dnd.patch",
    "react-is": "19.3.1",
    "node-gyp/undici": "6.29.1",
    "@types/react-dom": "19.3.0",
    "react-mosaic-component": "patch:react-mosaic-component@npm:6.2.0#./patches/react-mosaic-component.patch",
    "monaco-editor/dompurify": "3.4.17",
    "glob@npm:^10.4.1": "14.0.4",
    "glob@npm:^13.0.6": "14.0.4",
    "minimatch@npm:^9.0.3": "11.0.5",
    "minimatch@npm:^9.0.4": "11.0.5",
    "minimatch@npm:^10.2.2": "11.0.5",
    "minimatch@npm:^10.2.5": "11.0.5",
    "react-mosaic-component/uuid": "11.1.1",
    "@foxglove/xmlrpc": "1.3.0",
    "xmlbuilder2/js-yaml": "3.15.2"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@coscene-io/eslint-plugin": "workspace:*",
    "@foxglove/tsconfig": "3.2.0",
    "@jest/globals": "30.5.2",
    "@rspack/cli": "2.3.2",
    "@rspack/core": "2.3.2",
    "@rspack/dev-server": "2.2.2",
    "@rspack/plugin-react-refresh": "2.0.2",
    "@sentry/webpack-plugin": "11.12.0",
    "@swc/core": "1.16.22",
    "@swc/jest": "0.2.39",
    "@types/cytoscape-dagre": "workspace:*",
    "@types/foxglove__roslibjs": "workspace:*",
    "@types/foxglove__web": "workspace:*",
    "@types/jest": "30.0.0",
    "@types/license-checker": "^25.0.6",
    "@types/memoize-weak": "workspace:*",
    "@types/node": "26.6.6",
    "@types/protobufjs": "workspace:*",
    "@types/text-metrics": "workspace:*",
    "@types/wicg-file-system-access": "2023.10.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "cross-env": "10.1.0",
    "electron-builder": "26.18.0",
    "esa-cli": "1.0.13",
    "eslint": "9.39.5",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-tss-unused-classes": "1.0.4",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "knip": "6.45.1",
    "license-checker": "25.0.1",
    "node-loader": "2.1.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-refresh": "0.19.0",
    "rimraf": "6.1.4",
    "ts-node": "10.9.2",
    "ts-unused-exports": "11.0.1",
    "tslib": "2.9.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.2",
    "webpack": "5.112.2"
  }
}
